# Data (raw, interim, and processed) is not version-controlled -- it's
# regenerated by running the pipeline scripts. Keep only the code, config,
# and the .gitkeep placeholders in git.
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
*.egg-info/
